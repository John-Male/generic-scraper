#!/usr/bin/env python3
"""Project acceptance entrypoint generator.

Turns one parser-produced JSON IR file into a pytest module that runs every
scenario execution the IR represents. The generated module embeds the IR and
delegates all step behaviour to ``tests.acceptance.runtime`` and the project
step handlers -- it never parses the source ``.feature``.

Usage:
    acceptance-entrypoint-generator <json-ir> <generated-test-output-dir>

Exit codes: 0 success, 1 IO/generation error, 2 wrong usage.
"""

from __future__ import annotations

import hashlib
import json
import re
import sys
from pathlib import Path

_HEADER = '"""GENERATED by acceptance-entrypoint-generator. Do not edit.\n\nSource IR: {ir_path}\n"""\n'


def _metadata_name(feature_path: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", feature_path.lower()).strip("-")
    return f"{slug}.json"


def _render(ir: dict, ir_path: str) -> str:
    ir_literal = json.dumps(ir, indent=4, sort_keys=True)
    return (
        _HEADER.format(ir_path=ir_path)
        + "\n"
        + "import pytest\n\n"
        + "from tests.acceptance.runtime import iter_executions, run_execution\n\n\n"
        + f"IR = {ir_literal}\n\n\n"
        + "_EXECUTIONS = iter_executions(IR)\n\n\n"
        + "@pytest.mark.parametrize(\n"
        + '    "execution", _EXECUTIONS, ids=[execution.id for execution in _EXECUTIONS]\n'
        + ")\n"
        + "def test_acceptance(execution: object) -> None:\n"
        + "    run_execution(execution)\n"
    )


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        sys.stderr.write(
            "usage: acceptance-entrypoint-generator <json-ir> <output-dir>\n"
        )
        return 2

    ir_path = Path(argv[0])
    out_dir = Path(argv[1])
    try:
        ir = json.loads(ir_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        sys.stderr.write(f"cannot read IR {ir_path}: {error}\n")
        return 1

    stem = ir_path.stem
    feature_path = f"features/{stem}.feature"
    test_path = out_dir / f"test_{stem}.py"
    meta_path = out_dir / "metadata" / _metadata_name(feature_path)

    try:
        out_dir.mkdir(parents=True, exist_ok=True)
        meta_path.parent.mkdir(parents=True, exist_ok=True)
        source = _render(ir, str(ir_path))
        test_path.write_text(source)
        digest = hashlib.sha256(source.encode("utf-8")).hexdigest()
        meta_path.write_text(
            json.dumps(
                {
                    "schema_version": 1,
                    "feature_path": feature_path,
                    "ir_path": str(ir_path),
                    "implementation_hash": f"sha256:{digest}",
                    "hash_scope": "generated_files",
                    "generated_files": [str(test_path)],
                },
                indent=2,
                sort_keys=True,
            )
            + "\n"
        )
    except OSError as error:
        sys.stderr.write(f"cannot write generated tests: {error}\n")
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
