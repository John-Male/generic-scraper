{
  "name" : "Distributed execution, artifact upload, and node affinity",
  "scenarios" : [ {
    "name" : "distributed_execution_and_artifacts-1",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "I have a ScraperType configuration with \"scraper_engine\" set to \"requests\""
    }, {
      "keyword" : "And",
      "text" : "the job is configured to run with <shards> parallel shards",
      "parameters" : [ "shards" ]
    }, {
      "keyword" : "When",
      "text" : "the orchestrator schedules the job"
    }, {
      "keyword" : "Then",
      "text" : "the job should run on <shards> distinct worker nodes",
      "parameters" : [ "shards" ]
    }, {
      "keyword" : "And",
      "text" : "each worker should produce a parsed artifact"
    } ],
    "examples" : [ {
      "shards" : "3"
    }, {
      "shards" : "5"
    } ]
  }, {
    "name" : "distributed_execution_and_artifacts-2",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "a worker produced \"<artifact>\"",
      "parameters" : [ "artifact" ]
    }, {
      "keyword" : "When",
      "text" : "the worker finishes the shard"
    }, {
      "keyword" : "Then",
      "text" : "the artifact \"<artifact>\" should be uploaded to the job artifact store",
      "parameters" : [ "artifact" ]
    } ],
    "examples" : [ {
      "artifact" : "parsed_result.json"
    } ]
  }, {
    "name" : "distributed_execution_and_artifacts-3",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "a ScraperType configuration with \"browser_type\" set to \"chrome\""
    }, {
      "keyword" : "And",
      "text" : "the job requests GPU false and memory 2GB"
    }, {
      "keyword" : "When",
      "text" : "the orchestrator schedules the job"
    }, {
      "keyword" : "Then",
      "text" : "the job should be placed on a node that satisfies the resource constraints"
    } ],
    "examples" : [ ]
  } ]
}
