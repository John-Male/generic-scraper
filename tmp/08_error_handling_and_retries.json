{
  "name" : "Error handling, retries, and fallback behavior",
  "scenarios" : [ {
    "name" : "error_handling_and_retries-1",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "I have a ScraperType configuration with \"scraper_engine\" set to \"requests\""
    }, {
      "keyword" : "And",
      "text" : "retry policy set to <attempts> attempts with exponential backoff",
      "parameters" : [ "attempts" ]
    }, {
      "keyword" : "When",
      "text" : "a transient network error occurs during fetch"
    }, {
      "keyword" : "Then",
      "text" : "the Scraper should retry up to <attempts> times before failing",
      "parameters" : [ "attempts" ]
    } ],
    "examples" : [ {
      "attempts" : "3"
    }, {
      "attempts" : "5"
    } ]
  }, {
    "name" : "error_handling_and_retries-2",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "I have a ScraperType configuration with \"scraper_engine\" set to \"<engine>\"",
      "parameters" : [ "engine" ]
    }, {
      "keyword" : "And",
      "text" : "\"secondary\" set to \"requests\""
    }, {
      "keyword" : "And",
      "text" : "\"<engine>\" fails to start on the worker",
      "parameters" : [ "engine" ]
    }, {
      "keyword" : "When",
      "text" : "I initialize the Scraper"
    }, {
      "keyword" : "Then",
      "text" : "the Scraper should attempt to use \"requests\" as the secondary engine"
    }, {
      "keyword" : "And",
      "text" : "the initialization should succeed"
    } ],
    "examples" : [ {
      "engine" : "selenium"
    }, {
      "engine" : "playwright"
    } ]
  }, {
    "name" : "error_handling_and_retries-3",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "I have a ScraperType configuration with \"scraper_engine\" set to \"<engine>\"",
      "parameters" : [ "engine" ]
    }, {
      "keyword" : "When",
      "text" : "I initialize the Scraper"
    }, {
      "keyword" : "Then",
      "text" : "the Scraper initialization should fail with \"<error>\"",
      "parameters" : [ "error" ]
    } ],
    "examples" : [ {
      "engine" : "unknown",
      "error" : "UnsupportedScraperEngineError"
    } ]
  } ]
}
