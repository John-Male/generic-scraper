{
  "name" : "End-to-end fetch and parse using configured options",
  "scenarios" : [ {
    "name" : "end_to_end_fetch_parse-1",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "I have a ScraperType configuration with \"scraper_engine\" set to \"<engine>\"",
      "parameters" : [ "engine" ]
    }, {
      "keyword" : "And",
      "text" : "\"processing_type\" set to \"<processor>\"",
      "parameters" : [ "processor" ]
    }, {
      "keyword" : "When",
      "text" : "I initialize the Scraper on a worker node"
    }, {
      "keyword" : "And",
      "text" : "I fetch the test URL"
    }, {
      "keyword" : "Then",
      "text" : "the Scraper should return a parsed document using \"<processor>\"",
      "parameters" : [ "processor" ]
    }, {
      "keyword" : "And",
      "text" : "the parsed document should contain the page title"
    } ],
    "examples" : [ {
      "engine" : "requests",
      "processor" : "beautifulsoup"
    }, {
      "engine" : "requests",
      "processor" : "lxml"
    }, {
      "engine" : "selenium",
      "processor" : "beautifulsoup"
    }, {
      "engine" : "playwright",
      "processor" : "html.parser"
    } ]
  } ],
  "background" : [ {
    "keyword" : "Given",
    "text" : "a test URL \"https://example.com/test-page\""
  } ]
}
