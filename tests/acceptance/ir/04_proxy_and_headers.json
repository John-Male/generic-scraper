{
  "name" : "Proxy configuration and header pass key",
  "scenarios" : [ {
    "name" : "proxy_and_headers-1",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "\"scraper_engine\" set to \"requests\""
    }, {
      "keyword" : "And",
      "text" : "\"proxy_url\" set to \"<proxy_url>\"",
      "parameters" : [ "proxy_url" ]
    }, {
      "keyword" : "And",
      "text" : "\"proxy_port\" set to \"<proxy_port>\"",
      "parameters" : [ "proxy_port" ]
    }, {
      "keyword" : "When",
      "text" : "I initialize the Scraper on a worker node"
    }, {
      "keyword" : "Then",
      "text" : "the Scraper should configure the HTTP client to use the proxy \"<proxy_url>:<proxy_port>\"",
      "parameters" : [ "proxy_url", "proxy_port" ]
    } ],
    "examples" : [ {
      "proxy_url" : "http://proxy.example",
      "proxy_port" : "8080"
    }, {
      "proxy_url" : "http://proxy.internal",
      "proxy_port" : "3128"
    } ]
  }, {
    "name" : "proxy_and_headers-2",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "\"proxy_pass_key\" set to \"<pass_key>\"",
      "parameters" : [ "pass_key" ]
    }, {
      "keyword" : "And",
      "text" : "\"proxy_pass_val\" set to \"<pass_val>\"",
      "parameters" : [ "pass_val" ]
    }, {
      "keyword" : "When",
      "text" : "I initialize the Scraper"
    }, {
      "keyword" : "Then",
      "text" : "the Scraper should include header \"<pass_key>: <pass_val>\" on proxied requests",
      "parameters" : [ "pass_key", "pass_val" ]
    } ],
    "examples" : [ {
      "pass_key" : "X-Proxy-Auth",
      "pass_val" : "dummy-token-abc"
    }, {
      "pass_key" : "X-Auth-Token",
      "pass_val" : "dummy-token-xyz"
    } ]
  } ],
  "background" : [ {
    "keyword" : "Given",
    "text" : "I have a ScraperType configuration with \"use_proxy\" set to \"true\""
  } ]
}
